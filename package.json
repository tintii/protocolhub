{
  "name": "protocolhub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "validate": "node scripts/validate.mjs",
    "build": "npm run validate && astro build && node scripts/search.mjs && node scripts/check-artifact.mjs",
    "preview": "astro preview",
    "migrate": "node scripts/migrate.mjs",
    "refresh:rfcs": "node scripts/refresh-rfcs.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:extension": "node tests/extension.mjs",
    "test:self-contained": "node tests/self-contained.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.7",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.12.0",
    "gray-matter": "4.0.3",
    "lucide-static": "1.70.0",
    "marked": "18.1.3",
    "pagefind": "1.6.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/sanitize-html": "2.16.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
