---
import Layout from "../../../layouts/Layout.astro";
import RfcCatalog from "../../../components/RfcCatalog.astro";
import { readRfcs } from "../../../lib/content.mjs";
export function getStaticPaths() {
  const count = Math.ceil(readRfcs().entries.length / 100);
  return ["newest", "oldest"].flatMap((order) =>
    Array.from({ length: count }, (_, i) => ({
      params: { order, page: String(i + 1) },
      props: { order, page: i + 1 },
    })),
  );
}
const { order, page } = Astro.props;
---

<Layout title={`RFC catalog · ${order} · page ${page}`} section="RFCs">
  <RfcCatalog order={order} page={page} />
</Layout>
